{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug startup service",
      "program": "${workspaceFolder}/service/index.js",
      "cwd": "${workspaceFolder}",
      "args": ["4000"],
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Attach to startup service",
      "address": "127.0.0.1",
      "port": 9229,
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
